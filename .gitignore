# =====================================================================
#  Reativa Systems — .gitignore
#  Monorepo: backend Python (FastAPI) + frontend Next.js (TS)
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
#  SECRETS — NUNCA VERSIONAR
# ─────────────────────────────────────────────────────────────────────
# Tokens do Notion, Gemini, etc. Sempre fora do Git.
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# Mas mantém os exemplos versionados (ajudam quem clonar o repo)
!.env.example
!.env.local.example
!.env.*.example

# Chaves criptográficas
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# Configs sensíveis avulsas
config.json
secrets.json
credentials.json
service-account*.json

# ─────────────────────────────────────────────────────────────────────
#  DADOS DE NEGÓCIO — backend/data/
# ─────────────────────────────────────────────────────────────────────

backend/data/raw/
backend/data/processed/
backend/data/sent/
backend/data/cache/
backend/data/sessao/
backend/data/unmapped_fields.json

!backend/data/
!backend/data/.gitkeep
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/sent/.gitkeep
!backend/data/cache/.gitkeep
!backend/data/sessao/.gitkeep

# ─────────────────────────────────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────────────────────────────────
logs/
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────
#  PYTHON
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testes Python
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────────────
#  NODE / NPM / YARN / PNPM
# ─────────────────────────────────────────────────────────────────────
node_modules/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.pnpm-store/

# ─────────────────────────────────────────────────────────────────────
#  NEXT.JS
# ─────────────────────────────────────────────────────────────────────
.next/
out/
.vercel/
.turbo/


next-env.d.ts

# ─────────────────────────────────────────────────────────────────────
#  TYPESCRIPT
# ─────────────────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────
#  IDEs E EDITORES
# ─────────────────────────────────────────────────────────────────────
# VSCode (mantém só o que pode ser compartilhado, se você criar)
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
.gradle/

# Sublime
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt][a-z]
Session.vim
.exrc
*.swp
*.swo

# Emacs
*~
\#*\#
.\#*

# ─────────────────────────────────────────────────────────────────────
#  SISTEMA OPERACIONAL
# ─────────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.TemporaryItems

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.directory

# ─────────────────────────────────────────────────────────────────────
#  ARQUIVOS TEMPORÁRIOS
# ─────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig
*.rej

# ─────────────────────────────────────────────────────────────────────
#  DOCKER (caso adicione depois)
# ─────────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker-compose.override.yml
.dockerignore.local

