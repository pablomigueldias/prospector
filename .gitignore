# =====================================================================
#  Reative Systems — .gitignore
#  Monorepo: backend Python (FastAPI) + frontend Next.js (TS)
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
#  SECRETS — NUNCA VERSIONAR
# ─────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# Mantém os exemplos versionados (ajudam quem clonar o repo)
!.env.example
!.env.local.example
!.env.*.example

# Chaves criptográficas
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# Configs sensíveis avulsas
config.json
secrets.json
credentials.json
service-account*.json

# ─────────────────────────────────────────────────────────────────────
#  DADOS DE NEGÓCIO — backend/data/
# ─────────────────────────────────────────────────────────────────────
backend/data/raw/
backend/data/processed/
backend/data/sent/
backend/data/cache/
backend/data/sessao/
backend/data/debug/
backend/data/emails/
backend/data/unmapped_fields.json

!backend/data/
!backend/data/.gitkeep
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep
!backend/data/sent/.gitkeep
!backend/data/cache/.gitkeep
!backend/data/sessao/.gitkeep

# ─────────────────────────────────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────────────────────────────────
logs/
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────
#  PYTHON
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testes Python
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────────────
#  BANCO DE DADOS / ALEMBIC  (Passo 1+)
# ─────────────────────────────────────────────────────────────────────
# Os scripts de migration em alembic/versions/*.py DEVEM ir pro git.
# Mas dumps, backups e SQL gerado local NÃO.
*.sql.bak
*.dump
*.sqlite
*.sqlite3
*.db
backend/alembic/versions/*.sql      # SQL gerado por `alembic upgrade head --sql`

# ─────────────────────────────────────────────────────────────────────
#  NODE / NPM / YARN / PNPM
# ─────────────────────────────────────────────────────────────────────
node_modules/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.pnpm-store/

# ─────────────────────────────────────────────────────────────────────
#  NEXT.JS
# ─────────────────────────────────────────────────────────────────────
.next/
out/
.vercel/
.turbo/
next-env.d.ts

# ─────────────────────────────────────────────────────────────────────
#  TYPESCRIPT
# ─────────────────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────
#  IDEs E EDITORES
# ─────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
.gradle/
*.sublime-project
*.sublime-workspace
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt][a-z]
Session.vim
.exrc
*.swp
*.swo
*~
\#*\#
.\#*

# ─────────────────────────────────────────────────────────────────────
#  SISTEMA OPERACIONAL
# ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.TemporaryItems
Thumbs.db
ehthumbs.db
Desktop.ini
.directory

# ─────────────────────────────────────────────────────────────────────
#  ARQUIVOS TEMPORÁRIOS
# ─────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig
*.rej

# ─────────────────────────────────────────────────────────────────────
#  DOCKER
# ─────────────────────────────────────────────────────────────────────
# NOTA: docker-compose.yml DEVE ser versionado (não tem secret, só
# config de dev local). Só ignoramos overrides e arquivos locais.
docker-compose.override.yml
.docker-compose.override.yml
.dockerignore.local

# ─────────────────────────────────────────────────────────────────────
#  PLAYWRIGHT
# ─────────────────────────────────────────────────────────────────────
playwright-report/
test-results/
playwright/.cache/