# ────────────────────────────────────────────────────────────────────────────
#  Caddyfile — HTTPS automático (Let's Encrypt) + roteamento
#
#  - {$DOMAIN}        → front Next.js (web:3000)
#  - {$DOMAIN}/api/*  → API FastAPI (api:8000), caminho preservado (os routers
#                       já têm o prefixo /api, então NÃO se remove o /api aqui)
#  - {$DOMAIN}/telegram/*  → API (webhook do bot)
#
#  Caddy emite e renova o certificado sozinho na primeira visita HTTPS.
# ────────────────────────────────────────────────────────────────────────────
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd

	# ── Headers de segurança (aplicados a todas as respostas) ──────────
	header {
		# Força HTTPS por 1 ano (inclui subdomínios; elegível a preload)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Anti-MIME-sniffing
		X-Content-Type-Options "nosniff"
		# Anti-clickjacking (redundante com frame-ancestors, mas cobre browsers antigos)
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP: front e API são same-origin (via Caddy), então 'self' cobre fetch/SSE.
		# 'unsafe-inline' no script é pragmático pro Next (Pages Router); dá pra
		# trocar por nonce no futuro sem mexer no resto.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		# Não revela a versão do servidor
		-Server
	}

	# Webhook do Telegram vai direto pra API (caminho preservado)
	handle /telegram/* {
		reverse_proxy api:8000
	}

	# Tudo sob /api/* vai pra API, com o caminho preservado (sem remover /api).
	handle /api/* {
		reverse_proxy api:8000
	}

	# Resto: front Next.js
	handle {
		reverse_proxy web:3000
	}
}

# ────────────────────────────────────────────────────────────────────────────
#  CDN das imagens do blog — só o bucket PÚBLICO `blog` do MinIO é roteado.
#  Buckets privados (comprovantes/boletos/notas) NÃO são acessíveis por aqui.
#  Requer: DNS A de {$CDN_DOMAIN} → IP do VPS. Sem CDN_DOMAIN setado, o compose
#  passa `cdn.localhost` (cert interno, inofensivo) — não quebra o deploy.
# ────────────────────────────────────────────────────────────────────────────
{$CDN_DOMAIN} {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=31536000, immutable"
		-Server
	}
	handle /blog/* {
		reverse_proxy minio:9000
	}
	respond 404
}
