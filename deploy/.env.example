# =============================================================================
# .env.example — template de segredos da stack no VPS
# Copie pra .env e preencha:  cp .env.example .env && nano .env
# O .env NUNCA vai pro git (ver deploy/.gitignore).
#
# Gerar senhas:        openssl rand -base64 24
# Gerar webhook secret: openssl rand -hex 16
# =============================================================================

# --- Domínio / HTTPS ---------------------------------------------------------
# Subdomínio com registro A apontando pro IP do VPS (Etapa 2.1)
DOMAIN=financas.seudominio.com.br
# E-mail pro Let's Encrypt avisar sobre o certificado
ACME_EMAIL=voce@seudominio.com.br

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=reative
POSTGRES_PASSWORD=TROQUE_openssl_rand_base64_24
POSTGRES_DB=reative

# --- MinIO (S3 self-hosted) --------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROQUE_openssl_rand_base64_24
# Endpoint interno usado pela API (rede do compose)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
# --- Blog headless: imagens públicas (B-IMG) ---------------------------------
# URL PÚBLICA permanente das imagens do blog (capa/conteúdo). Aponta pro MinIO
# exposto atrás do Caddy. Deixe VAZIO pra cair no S3_ENDPOINT (só vale em dev).
# Em prod: subdomínio cdn (ver bloco no Caddyfile + DNS A pro IP do VPS).
S3_PUBLIC_URL=https://cdn.seudominio.com.br
S3_BUCKET_BLOG=blog
# Domínio do cdn (usado pelo Caddyfile). Sem cdn ainda? deixe IGUAL a S3_ENDPOINT
# vazio e NÃO habilite o bloco cdn no Caddyfile.
CDN_DOMAIN=cdn.seudominio.com.br
# Site institucional público (pro sitemap.xml/feed.xml do blog apontarem certo)
SITE_URL=https://seudominio.com.br

# --- Notion (obrigatórios pro Prospector subir) ------------------------------
NOTION_TOKEN=
NOTION_DB_EMPRESAS=
NOTION_DB_CONTATOS=

# --- LLMs --------------------------------------------------------------------
GEMINI_API_KEY=
# Modelo de imagem do blog (Imagen). A chave precisa ter acesso ao Imagen 4.
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GROQ_API_KEY=

# --- E-mail (outreach) -------------------------------------------------------
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.hostinger.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_FROM_NAME=Reative Systems

# --- Telegram (Organizador Financeiro) ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_SANDRA=
# secret_token do webhook (openssl rand -hex 16) — protege o endpoint
TELEGRAM_WEBHOOK_SECRET=

# --- Agendador / lembretes (Organizador Financeiro) --------------------------
# Roda 1x/dia: processa recorrências (gera previstas + marca atrasadas) e manda
# o digest de contas a pagar no Telegram. Os defaults já servem.
SCHEDULER_ENABLED=true       # liga o agendador no startup da API
LEMBRETES_ENABLED=true       # manda o digest de vencimento no Telegram
LEMBRETES_HORA=8             # hora local (TIMEZONE) do envio
LEMBRETES_DIAS_ANTES=3       # avisa boletos vencendo em até N dias
ORCAMENTO_ALERTA_PCT=80      # alerta categorias acima de X% do teto no digest
TIMEZONE=America/Sao_Paulo

# --- Auth / login ------------------------------------------------------------
# Em produção (HTTPS via Caddy) deixe true → cookie Secure + __Host-.
SESSION_COOKIE_SECURE=true
# Seed do admin (python -m app.jobs.seed_admin). Troque a senha no 1º acesso.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
# 2FA TOTP: chave Fernet pra cifrar o secret no banco. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA troque depois que alguém ativar o 2FA (os secrets ficariam ilegíveis).
TOTP_ENC_KEY=

# --- Frontend ----------------------------------------------------------------
# URL pública da API consumida pelo Next (embutida no build).
# SEM o sufixo /api: o front já monta os caminhos como /api/... e o Caddy
# preserva o prefixo (handle, não handle_path). Pôr /api aqui gera /api/api/* → 404.
NEXT_PUBLIC_API_URL=https://financas.seudominio.com.br

# --- Ferramentas de dev ------------------------------------------------------
# NUNCA habilite em produção. Libera rotas destrutivas (ex.: sync produção→dev,
# que APAGA o banco). Deixe ausente/false aqui; só o .env de dev usa =true.
DEV_TOOLS_ENABLED=false
